## 
# To get the next server running for local development, you should copy
# the following values into an .env.development file 

API_HOSTNAME=127.0.0.1
NEXT_PUBLIC_CONTENT_API_BASE_URL="http://$API_HOSTNAME:8000/api/v2"
NEXT_PUBLIC_CONTENT_CMS_API_BASE_URL="http://$API_HOSTNAME:8000/api/cms"
NEXT_PUBLIC_IMAGE_DOMAIN="http://$API_HOSTNAME:8000"

GOOGLE_MAPS_API_KEY="" # Reach out to the sf.gov dev team for this key
TRANSLATIONS_API_TOKEN="" # key to access translations api.  set in the platform django-admin
TRANSLATIONS_STATIC_STRINGS_URL="http://$API_HOSTNAME:8000/api/cms/cms.InlineDisplayText" # Local dev url to get translations from the platform
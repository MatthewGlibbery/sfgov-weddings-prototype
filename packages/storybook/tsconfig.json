{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es5",
    "baseUrl": ".",
    "paths": {
      "@/design-system": [
        "../design-system"
      ],
      "@/design-system/*": [
        "../design-system/*"
      ],
      "@/sfgov/*": [
        "../sfgov/*"
      ]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": []
}
{
  "private": true,
  "name": "sfgov-next",
  "engines": {
    "node": "20.11.0"
  },
  "scripts": {
    "build": "npm run build -w @sfgov/next -w @sfgov/design-system",
    "dev": "npm run dev -w @sfgov/next",
    "lint": "npm run lint -w @sfgov/next -w @sfgov/design-system",
    "test": "npm run test -w @sfgov/next -w @sfgov/design-system",
    "storybook": "npm run storybook -w sfgov-storybook",
    "build-storybook": "npm run build -w sfgov-storybook",
    "e2e": "npx playwright test -w @sfgov/next",
    "translations-gather": "rm -f locales/en/translation.json 2> /dev/null; npx i18next-parser",
    "translations-upload": "node tools/scripts/translations-upload.mjs",
    "translate": "npm run translations-gather && npm run translations-upload"
  },
  "dependencies": {
    "@types/node": "18.14.2",
    "autoprefixer": "^10.4.14",
    "i18next-parser": "^9.0.2",
    "node-factory": "^0.4.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "^3.4.13",
    "tslib": "2.7.0",
    "typescript": "~4.9.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.4.0",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@types/testing-library__jest-dom": "^5.14.5",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "env-cmd": "^10.1.0",
    "eslint": "^8.31.0",
    "eslint-config-next": "^13.1.1",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-sfgov": "^2.0.0",
    "eslint-plugin-testing-library": "^5.10.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1",
    "jest-fetch-mock": "^3.0.3",
    "jest-mock-console": "^2.0.0",
    "mocked-env": "^1.3.5",
    "node-mocks-http": "^1.12.1",
    "postcss": "^8.4.31",
    "prettier": "^2.8.8",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.0.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.24.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
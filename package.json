{
  "private": true,
  "name": "sfgov-next",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "figma-export": "env-cmd -f .env.local figma-export use-config",
    "lint": "eslint . *.js",
    "postfigma-export": "eslint --fix 'design-system/components/icons/**/*.js{,x}'",
    "postinstall": "playwright install --with-deps",
    "prestart": "npm run build",
    "start": "next start",
    "test": "wireit",
    "test:unit": "jest --coverage",
    "test:browser": "playwright test",
    "prepare": "husky install"
  },
  "wireit": {
    "test": {
      "dependencies": [
        "test:unit",
        "test:browser"
      ]
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@sfgov/design-system": "^0.0.1",
    "@stitches/react": "^1.2.8",
    "micromatch": "^4.0.5",
    "next": "13.0.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-error-boundary": "^3.1.4",
    "safe-json-stringify": "^1.2.0"
  },
  "devDependencies": {
    "@figma-export/cli": "^4.5.0",
    "@figma-export/output-components-as-svg": "^4.5.0",
    "@figma-export/output-components-as-svgr": "^4.5.0",
    "@figma-export/transform-svg-with-svgo": "^4.5.0",
    "@figma-export/types": "^4.5.0",
    "@playwright/test": "^1.30.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/micromatch": "^4.0.2",
    "@types/node": "18.11.15",
    "@types/react": "18.0.26",
    "@types/testing-library__jest-dom": "^5.14.5",
    "env-cmd": "^10.1.0",
    "eslint": "^8.31.0",
    "eslint-config-next": "^13.1.1",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-sfgov": "^2.0.0",
    "eslint-plugin-testing-library": "^5.10.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "husky": "^8.0.0",
    "jest": "^29.4.0",
    "jest-environment-jsdom": "^29.4.0",
    "jest-fetch-mock": "^3.0.3",
    "jest-mock-console": "^2.0.0",
    "lint-staged": "^13.1.0",
    "mocked-env": "^1.3.5",
    "node-factory": "^0.4.2",
    "node-mocks-http": "^1.12.1",
    "typescript": "^4.9.4",
    "wireit": "^0.9.3"
  }
}
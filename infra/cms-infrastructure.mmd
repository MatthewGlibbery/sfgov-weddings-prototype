```mermaid
graph TB
    subgraph "DNS Layer"
        R53_WEB[Route53: web-training-ecs.dev.sf.gov]
        R53_API[Route53: api-training-ecs.dev.sf.gov]
    end

    subgraph "CDN + WAF Layer"
        CF_WEB[CloudFront Web]
        WAF_WEB[WAF Web ACL<br/>Rate: 550/IP]
        CF_API[CloudFront API]
        WAF_API[WAF API ACL<br/>Rate: 1000/IP]
    end

    subgraph "Load Balancer"
        ALB[ALB: cms-common]
        LR_WEB[Listener Rule :10]
        LR_API[Listener Rule :20]
    end

    subgraph "ECS Cluster: cms-common"
        subgraph "Web Service"
            ECS_WEB[ECS Service<br/>cms-training-web]
            TASK_WEB[Task Definition<br/>1024 CPU / 2048 MB]
            CONTAINER_WEB[Container: web<br/>Next.js :3000]
            TG_WEB[Target Group<br/>cms-training-web-tg]
        end

        subgraph "API Service"
            ECS_API[ECS Service<br/>cms-training-api]
            TASK_API[Task Definition<br/>1024 CPU / 2048 MB]
            CONTAINER_API[Container: api<br/>Django/Wagtail :80]
            TG_API[Target Group<br/>cms-training-api-tg]
        end
    end

    subgraph "Data Layer"
        RDS[(RDS PostgreSQL<br/>platform-training-db)]
        SECRETS[Secrets Manager<br/>sfgov-training-api]
    end

    subgraph "Container Registry"
        ECR_WEB[ECR: platform/web]
        ECR_API[ECR: platform/api]
    end

    subgraph "Monitoring"
        CW[CloudWatch Logs<br/>cms-training]
    end

    subgraph "Networking"
        VPC[VPC: platform_vpc]
        SG[Security Groups x6]
    end

    subgraph "IAM"
        TASK_ROLE[Task Role]
        EXEC_ROLE[Execution Role]
    end

    %% Connections
    R53_WEB --> CF_WEB
    R53_API --> CF_API
    CF_WEB --> WAF_WEB
    CF_API --> WAF_API
    CF_WEB --> ALB
    CF_API --> ALB
    ALB --> LR_WEB
    ALB --> LR_API
    LR_WEB --> TG_WEB
    LR_API --> TG_API
    TG_WEB --> ECS_WEB
    TG_API --> ECS_API
    ECS_WEB --> TASK_WEB
    TASK_WEB --> CONTAINER_WEB
    ECS_API --> TASK_API
    TASK_API --> CONTAINER_API
    CONTAINER_API --> RDS
    CONTAINER_API -.-> SECRETS
    ECR_WEB -.-> CONTAINER_WEB
    ECR_API -.-> CONTAINER_API
    CONTAINER_WEB --> CW
    CONTAINER_API --> CW
    ECS_WEB -.-> VPC
    ECS_API -.-> VPC
    ECS_WEB -.-> SG
    ECS_API -.-> SG
    TASK_WEB -.-> TASK_ROLE
    TASK_API -.-> TASK_ROLE
    TASK_WEB -.-> EXEC_ROLE
    TASK_API -.-> EXEC_ROLE

    style CF_WEB fill:#FF9900
    style CF_API fill:#FF9900
    style ALB fill:#FF9900

{
  "manifest_version": 3,
  "name": "SF.gov Git Hash Display",
  "version": "1.0",
  "description": "Automatically displays the deployed git hash on SF.gov pages",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["*://*.sf.gov/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
